let current = null;

function nextCard() {
    current = acronyms[Math.floor(Math.random() * acronyms.length)];
    document.getElementById("topic").innerHTML = `<h2>${current.topic}</h2>`;
    const acronymDiv = document.getElementById("acronym");
    acronymDiv.innerHTML = `<button class="btn" onclick="revealAcronym()">Reveal Acronym</button>`;
    acronymDiv.classList.remove("hidden");
    document.getElementById("letters").innerHTML = "";
}

function revealAcronym() {
    const acronymDiv = document.getElementById("acronym");
    acronymDiv.innerHTML = `<h2>${current.acronym}</h2>`;
    const lettersDiv = document.getElementById("letters");
    lettersDiv.innerHTML = "";

    for (const key in current.letters) {
        const span = document.createElement("span");
        span.className = "acronym-letter";
        span.textContent = key;
        span.onclick = () => {
            span.textContent = `${key} — ${current.letters[key]}`;
            span.style.background = "#cce5ff";
        };
        lettersDiv.appendChild(span);
    }
}
</script>

</body>
</html>
