<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>CP1 Acronym Trainer</title>
<meta name="viewport" content="width=device-width, initial-scale=1">
<style>
    body { font-family: Arial, sans-serif; max-width: 700px; margin: 20px auto; padding: 10px; }
    h1 { text-align: center; }
    .btn { padding: 12px 18px; background: #0078d4; color: white; border: none; cursor: pointer; border-radius: 6px; font-size: 16px; }
    .btn:hover { background: #005fa3; }
    .acronym-letter {
        display: inline-block;
        padding: 12px;
        margin: 6px;
        background: #eee;
        cursor: pointer;
        border-radius: 6px;
        font-size: 18px;
    }
    .hidden { display: none; }
</style>
</head>
<body>

<h1>CP1 Acronym Trainer</h1>

<div id="topic"></div>

<button class="btn" onclick="nextCard()">Next Topic</button>

<div id="acronym" class="hidden"></div>

<div id="letters"></div>

